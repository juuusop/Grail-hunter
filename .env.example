# Grail Hunter Configuration
# Copy this file to .env and adjust values as needed

# Application
APP_NAME="Grail Hunter"
DEBUG=false

# Database (SQLite by default, can use PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:///./grail_hunter.db"

# Sellpy/Algolia API (defaults are public Sellpy search keys)
ALGOLIA_APP_ID="50LBQU2I4A"
ALGOLIA_API_KEY="4e696a94df3469d5356870d63c118c87"
ALGOLIA_URL="https://50LBQU2I4A-dsn.algolia.net/1/indexes/*/queries"

# Scraping settings
SCRAPE_INTERVAL_SECONDS=300
HITS_PER_PAGE=60
MAX_PAGES=5

# Price filtering (in EUR)
MIN_PRICE=0.0
MAX_PRICE=500.0
