# Grail Hunter Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Application
# ===========================================
APP_NAME="Grail Hunter"
DEBUG=false

# ===========================================
# Database
# ===========================================
DATABASE_URL="sqlite+aiosqlite:///./grail_hunter.db"

# ===========================================
# Sellpy/Algolia API
# (Public search keys - no changes needed)
# ===========================================
ALGOLIA_APP_ID="50LBQU2I4A"
ALGOLIA_API_KEY="4e696a94df3469d5356870d63c118c87"
ALGOLIA_URL="https://50LBQU2I4A-dsn.algolia.net/1/indexes/*/queries"

# ===========================================
# Grailed API (Optional - for arbitrage)
# Get from browser dev tools on grailed.com
# ===========================================
GRAILED_ALGOLIA_APP_ID="MNRWEFSS2Q"
GRAILED_ALGOLIA_API_KEY="a3a4de2e05d9e9b463911705fb6323ad"

# ===========================================
# eBay API (Optional)
# ===========================================
# EBAY_APP_ID=

# ===========================================
# Notifications
# ===========================================
# Telegram Bot
# 1. Create bot via @BotFather
# 2. Get chat ID by messaging @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook (Alternative)
DISCORD_WEBHOOK_URL=

# Minimum deal rating for notifications: INSANE, GREAT, GOOD, FAIR
NOTIFICATION_MIN_RATING="GREAT"

# ===========================================
# Scraping Settings
# ===========================================
SCRAPE_INTERVAL_MINUTES=5
HITS_PER_PAGE=60
MAX_PAGES=5

# Rate limiting
MAX_CONCURRENT_REQUESTS=5
REQUEST_DELAY_SECONDS=0.5

# ===========================================
# Filtering
# ===========================================
MIN_PRICE=0.0
MAX_PRICE=500.0

# ===========================================
# Scheduler
# ===========================================
SCHEDULER_ENABLED=true
